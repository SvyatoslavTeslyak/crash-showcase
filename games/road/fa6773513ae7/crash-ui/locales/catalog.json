essages","games":["road"],"ht":"Lajan pran","usage":["text"],"presets":["tabbed-shell-v1"],"previewWindow":"betDetails"},"crashed_998507":{"source":"Crashed","en":"Crashed","fr":"Perdu","group":"Bet panel & messages","games":["road"],"ht":"Aksidan","usage":["text"],"presets":["tabbed-shell-v1"],"previewWindow":"betDetails"},"difficulty_9106e9":{"source":"DIFFICULTY","en":"DIFFICULTY","fr":"DIFFICULTÉ","group":"Bet panel & messages","games":["road"],"ht":"DIFIKILTE","usage":["text"],"previewWindow":"betDetails","presets":["tabbed-shell-v1"]},"lanes_crossed_abe605":{"source":"LANES","en":"LANES","fr":"VOIES","group":"Bet panel & messages","games":["road"],"ht":"LIY","usage":["text"],"previewWindow":"betDetails","presets":["tabbed-shell-v1"]},"round_restored_1dd750":{"source":"Round restored","en":"Round restored","fr":"Manche restaurée","group":"Bet panel & messages","games":["road"],"ht":"Tou a retabli","usage":["text"],"presets":["tabbed-shell-v1"],"previewState":"notification"},"close_bbfa77":{"source":"Close","en":"Close","fr":"Fermer","group":"Bet panel & messages","games":[],"ht":"Fèmen","usage":["aria-label"],"usageByGame":{"catch":["text","aria-label"]},"previewWindow":"topbets"},"back_to_value_150209":{"source":"Back to {value}","en":"Back to {value}","fr":"Retour à {value}","group":"Bet panel & messages","games":[],"ht":"Retounen nan {value}","usage":["aria-label"],"presets":["tabbed-shell-v1"],"previewWindow":"betDetails"},"x_c032ad":{"source":"X","en":"X","fr":"X","games":[],"group":"Difficulty & limits","ht":"X","usage":["text"],"previewWindow":"topbets","presets":["tabbed-shell-v1"]},"road_rules_document":{"source":"Guide the goat across the road one lane at a time. Every lane you clear raises the multiplier.\n\nPress **CASH OUT** at any lane to bank the current multiplier on your stake.\n\nSome lanes carry traffic. Step into one and the round ends with nothing.\n\nChoose Easy, Medium or Hard. Higher difficulty increases risk and reward. The risk meter shows the failure probability of the next step; in API mode it appears when the server supplies that probability.","en":"Guide the goat across the road one lane at a time. Every lane you clear raises the multiplier.\n\nPress **CASH OUT** at any lane to bank the current multiplier on your stake.\n\nSome lanes carry traffic. Step into one and the round ends with nothing.\n\nChoose Easy, Medium or Hard. Higher difficulty increases risk and reward. The risk meter shows the failure probability of the next step; in API mode it appears when the server supplies that probability.","fr":"Guidez la chèvre sur la route, une voie à la fois. Chaque voie franchie augmente le multiplicateur.\n\nAppuyez sur **ENCAISSER** à n’importe quelle voie pour encaisser votre mise au multiplicateur actuel.\n\nDes véhicules circulent sur certaines voies. Si vous en heurtez un, la manche se termine sans gain.\n\nChoisissez Facile, Moyen ou Difficile. Une difficulté plus élevée augmente le risque et le gain. La jauge indique la probabilité d’échec du prochain pas ; en mode API, elle apparaît lorsque le serveur fournit cette probabilité.","ht":"Ede kabrit la travèse wout la yon liy alafwa. Chak liy ou travèse ogmante miltiplikatè a.\n\nPeze **PRAN LAJAN** nan nenpòt liy pou pran gany miz ou a dapre miltiplikatè aktyèl la.\n\nGen liy kote machin ap pase. Si ou antre nan youn, tou a fini san ou pa genyen anyen.\n\nChwazi Fasil, Mwayen oswa Difisil. Plis nivo a difisil, se plis risk la ak rekonpans lan ogmante. Ba risk la montre pwobabilite pou pwochen pa a echwe; nan mòd API, li parèt lè sèvè a bay pwobabilite sa a.","label":"How to play · Content","format":"markdown","group":"Rules","games":["road"],"usage":["text"],"previewWindow":"rules"},"medium_d40496":{"source":"Medium","en":"Medium","fr":"Moyen","ht":"Mwayen","group":"Bet panel & messages","games":["road"],"usage":["text"]},"check_round_f2d124":{"source":"CHECK ROUND","en":"CHECK ROUND","fr":"","ht":"","group":"Bet panel & messages","games":["road"],"usage":["text"],"presets":["tabbed-shell-v1"]},"cash_out_to_finish_this_round_55f464":{"source":"Cash out to finish this round.","en":"Cash out to finish this round.","fr":"","ht":"","group":"Bet panel & messages","games":["road"],"usage":["text"],"presets":["tabbed-shell-v1"]},"multiplier_b94c55":{"source":"MULTIPLIER","en":"MULTIPLIER","fr":"MULTIPLICATEUR","ht":"MILTIPLIKATÈ","group":"Bet panel & messages","games":[],"usage":["text"],"previewWindow":"betDetails","presets":["tabbed-shell-v1"]},"cashed_out_value_f0e320":{"source":"Cashed out · {value}×","en":"Cashed out · {value}×","fr":"Encaissé · {value}×","ht":"Lajan pran · {value}×","group":"Bet panel & messages","games":[],"usage":["text"],"presets":["tabbed-shell-v1"]},"not_enough_funds_631600":{"source":"Not enough funds","en":"Not enough funds","fr":"","ht":"","group":"Bet panel & messages","games":["road"],"usage":["text"],"previewWindow":"notice:funds","presets":["tabbed-shell-v1"]},"your_balance_is_too_low_ece4eb":{"source":"Your balance is too low for this bet. Top up to keep playing.","en":"Your balance is too low for this bet. Top up to keep playing.","fr":"","ht":"","group":"Bet panel & messages","games":["road"],"usage":["text"],"previewWindow":"notice:funds","presets":["tabbed-shell-v1"]},"no_connection_e33899":{"source":"No connection","en":"No connection","fr":"","ht":"","group":"Bet panel & messages","games":["road"],"usage":["text"],"previewWindow":"notice:offline","presets":["tabbed-shell-v1"]},"you_seem_to_be_offline_c_e08e0d":{"source":"You seem to be offline. Check your connection and try again.","en":"You seem to be offline. Check your connection and try again.","fr":"","ht":"","group":"Bet panel & messages","games":["road"],"usage":["text"],"previewWindow":"notice:offline","presets":["tabbed-shell-v1"]},"try_again_042c86":{"source":"Try again","en":"Try again","fr":"","ht":"","group":"Bet panel & messages","games":["road"],"usage":["text"],"previewWindow":"notice:offline","presets